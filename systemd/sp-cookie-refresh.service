[Unit]
Description=Refresh SharePoint FedAuth cookies (headless login)
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/default/sp-webdav
# 首败静默：由 timer 的OnFailure 或 cron 重试负责二次通知
Environment=SP_NOTIFY_FAILURE=0
ExecStart=/usr/local/bin/sp-cookie-refresh.js
OnFailure=sp-cookie-refresh-retry.service
