# ---- Microsoft 账号（必填）----
SP_USERNAME=user@contoso.edu.cn
SP_PASSWORD=change-me

# ---- SharePoint 站点（必填）----
SP_SITE_URL=https://contoso.sharepoint.com/sites/mysite
# 可选：文档库 URL，默认 = SP_SITE_URL + /Shared%20Documents
#SP_DOCS_URL=https://contoso.sharepoint.com/sites/mysite/Shared%20Documents

# ---- 无头浏览器 ----
# playwright 安装的 chromium 路径示例：/root/.cache/ms-playwright/chromium-1223/chrome-linux/chrome
SP_CHROMIUM_PATH=/usr/bin/chromium

# ---- 运行文件 ----
SP_COOKIE_FILE=/var/lib/sp-webdav/cookies.json
SP_LOG_FILE=/var/log/sp-webdav-cookie-refresh.log
SP_LOCK_FILE=/run/sp-webdav-cookie-refresh.lock
SP_SHOT_DIR=/var/lib/sp-webdav/shots

# ---- rclone 联动 ----
SP_RCLONE_CONF=/root/.config/rclone/rclone.conf
SP_RCLONE_REMOTE=spcookie
SP_RCLONE_SERVICE=rclone-sp

# ---- Telegram 通知（留空则不通知）----
TG_TOKEN=
TG_CHAT_ID=
# 首败是否立即通知：0=静默（等 cron 重试），1=立即通知
SP_NOTIFY_FAILURE=1
SP_HOST_LABEL=my-vps

# ---- 密码生命周期提醒 ----
# 最近一次改密日期（YYYY-MM-DD），提醒脚本以此为起点
SP_PASSWORD_START_DATE=2026-01-01
# 租户约 90 天强制改密，提前多少天开始提醒
SP_REMIND_AFTER_DAYS=85

# ---- v4 运维增强 ----
SP_STATE_DIR=/var/lib/sp-webdav
SP_HEARTBEAT_FILE=/var/lib/sp-webdav/last-success.txt
SP_PASSWORD_HISTORY_FILE=/var/lib/sp-webdav/password-history.txt
SP_ENV_FILE=/etc/default/sp-webdav
SP_MOUNT_POINT=/mnt/sharepoint
SP_HEARTBEAT_MAX_HOURS=26
SP_DAILY_DIGEST=1
TG_ALLOWED_CHATS=
SP_REFRESH_SCRIPT=/opt/sp-webdav/scripts/sp-cookie-refresh.js